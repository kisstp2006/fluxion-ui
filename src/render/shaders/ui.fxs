// SPDX-License-Identifier: BSD-2-Clause

attribute vec2 a_corner : 0;
attribute vec4 a_rect : 1;
attribute vec4 a_color : 2;
attribute vec4 a_radii : 3;
attribute vec4 a_uv : 4;
attribute vec4 a_params : 5;
attribute vec4 a_motion : 6;
attribute vec4 a_fade : 7;

varying vec2 v_local;
varying vec2 v_half;
varying vec4 v_color;
varying vec4 v_radii;
varying vec2 v_uv;
varying float v_border;
varying float v_textured;
// Passed through as they are, for the kinds that use them: a border's four
// widths, and a shadow's caster - its box and its corners.
varying vec4 v_sides;
varying vec4 v_caster;

uniform Frame : 0 {
    vec4 u_viewport;
}

texture2d u_atlas : 0;

float roundedBox(vec2 p, vec2 b, vec4 r) {
    float radius = (p.x > 0.0) ? ((p.y < 0.0) ? r.y : r.z)
                               : ((p.y < 0.0) ? r.x : r.w);
    vec2 q = abs(p) - b + radius;
    return min(max(q.x, q.y), 0.0) + length(max(q, 0.0)) - radius;
}

vertex {
    vec2 pixel = a_rect.xy + a_corner * a_rect.zw;
    pixel = vec2(a_motion.x * pixel.x + a_motion.z * pixel.y,
                 a_motion.y * pixel.x + a_motion.w * pixel.y) + a_params.zw;
    v_local = (a_corner - 0.5) * a_rect.zw;
    v_half = a_rect.zw * 0.5;
    // A shape fades along the corner its uv weighs; the rest sample with it.
    float t = (a_params.y < 0.5) ? dot(a_corner, a_uv.xy) : 0.0;
    v_color = mix(a_color, a_fade, t);
    v_radii = a_radii;
    v_uv = mix(a_uv.xy, a_uv.zw, a_corner);
    v_border = a_params.x;
    v_textured = a_params.y;
    v_sides = a_fade;
    v_caster = a_uv;
    position = vec4(pixel.x / u_viewport.x * 2.0 - 1.0,
                    1.0 - pixel.y / u_viewport.y * 2.0, 0.0, 1.0);
}

fragment {
    if (v_textured > 3.5) {
        // A shadow: the box's distance through the curve a Gaussian blur
        // gives a straight edge, the logistic one, within a percent of it.
        // The quad reaches three sigmas past the box, which is where the
        // curve has run out. Nothing is drawn under the caster, so a
        // translucent element does not show its own shadow through itself.
        float sigma = max(v_border, 0.01);
        vec2 core = max(v_half - vec2(3.0 * sigma), vec2(0.0));
        float d = roundedBox(v_local, core, v_radii);
        float soft = 1.0 / (1.0 + exp(min(1.702 * d / sigma, 60.0)));
        if (v_caster.z > 0.0) {
            float caster = roundedBox(v_local - v_caster.xy, v_caster.zw, v_sides);
            soft = soft * (1.0 - clamp(0.5 - caster, 0.0, 1.0));
        }
        target = vec4(v_color.rgb, v_color.a * soft);
    } else if (v_textured > 2.5) {
        // An emoji: premultiplied in the atlas, so a filtered edge fades to
        // nothing; divided back out for the straight-alpha blend.
        vec4 texel = sample(u_atlas, v_uv);
        target = vec4(texel.rgb / max(texel.a, 0.0001), texel.a * v_color.a);
    } else if (v_textured > 0.5 && v_textured < 1.5) {
        target = vec4(v_color.rgb, v_color.a * sample(u_atlas, v_uv).a);
    } else {
        float outer = roundedBox(v_local, v_half, v_radii);
        float alpha = clamp(0.5 - outer, 0.0, 1.0);
        if (v_textured > 1.5) {
            vec4 texel = sample(u_atlas, v_uv);
            target = vec4(texel.rgb * v_color.rgb, texel.a * v_color.a * alpha);
        } else {
            if (v_border > 0.0) {
                // The hole is the box less each side's width - left, top,
                // right, bottom - and its corners as much smaller as the
                // wider of the two sides that meet there.
                vec4 s = v_sides;
                vec2 inner_half = max(v_half - vec2(s.x + s.z, s.y + s.w) * 0.5, vec2(0.0));
                vec2 inner_centre = vec2(s.x - s.z, s.y - s.w) * 0.5;
                vec4 inner_radii = max(v_radii - vec4(max(s.x, s.y), max(s.z, s.y), max(s.z, s.w), max(s.x, s.w)), vec4(0.0));
                float inner = roundedBox(v_local - inner_centre, inner_half, inner_radii);
                alpha *= clamp(0.5 + inner, 0.0, 1.0);
            }
            target = vec4(v_color.rgb, v_color.a * alpha);
        }
    }
}

// SPDX-License-Identifier: BSD-2-Clause

.{
    .name = .fluxion_ui,
    .version = "0.1.0",
    .minimum_zig_version = "0.16.0",
    .fingerprint = 0x50b56cb5b3160e97,
    .dependencies = .{
        // The library's one dependency, and it is one type deep: `Vec2`, for
        // a point. A layout is arithmetic, and this is the package whose job
        // that is.
        .fluxion_math = .{
            .url = "git+https://github.com/kisstp2006/fluxion-math#92afdbddbf930369265d24136402c7eb5dd8f70e",
            .hash = "fluxion_math-0.1.0-dfpZBeNUBAAwUMriLKaOTRBWGFmfY53_jyYuMUxkPYek",
        },

        // What one example measures and draws text with. Lazy, and named
        // here rather than imported by the library: a layout asks how wide a
        // run of text is and does not care who answers - see `text.Measurer`.
        .fluxion_font = .{
            .url = "git+https://github.com/kisstp2006/fluxion-font#f666e62f498e5bfe04361c7f1bf6531334a51dbf",
            .hash = "fluxion_font-0.1.0-f3pT4rn1AwBbbEom4emICxRn1vGPQvsRhUc0_lCawLB8",
            .lazy = true,
        },

        // What the optional `fluxion_ui_rhi` module draws with. Lazy for the
        // same reason: the library's own output is a command list, and a
        // program with its own renderer never fetches this. Pinned to a commit
        // that draws in browsers and on Android.
        .fluxion_rhi = .{
            .url = "git+https://github.com/kisstp2006/fluxion-rhi#703f3ba78b09f68e4e8f646f5faa98768c09fad4",
            .hash = "fluxion_rhi-0.1.0--pvwDzH4BACc6v7nBnF6meOzhNAdNz8_6eQ8twGQ4vx2",
            .lazy = true,
        },

        // What that module writes its shader in: one source, and every
        // backend's language comes out of it. Lazy with the renderer, and
        // for the same reason. Without it the same shader would be in this
        // repository three times, in three languages, drifting apart.
        // Pinned to a commit that writes GLSL ES 3.00 as well.
        .fluxion_shader = .{
            .url = "git+https://github.com/kisstp2006/fluxion-shader#8393b0ca67ec1dc22aaec248e6761599cdebb043",
            .hash = "fluxion_shader-0.1.0-FqFMEtqNAwDK2frc4mVFy7twFdZoEx9dVEZsZ5EuuHnX",
            .lazy = true,
        },

        // The window one example opens. Lazy, and the library imports it
        // nowhere: a layout engine has no business opening windows.
        .fluxion_platform = .{
            .url = "git+https://github.com/kisstp2006/fluxion-platform#fa246b1be8b3edfe827422094d049ec75ef20929",
            .hash = "fluxion_platform-0.1.0-WsOjUUdvFwBsx5RDEUqSL2wtPm-7WSZLQ9Hfh-Q5WEvP",
            .lazy = true,
        },
    },
    .paths = .{
        "build.zig",
        "build.zig.zon",
        "src",
        "examples",
        "README.md",
        "LICENSE",
    },
}
